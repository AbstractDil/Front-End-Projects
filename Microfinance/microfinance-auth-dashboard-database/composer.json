{
    "name": "mfi/microfinance-management-system",
    "description": "Production-ready Microfinance Management System (API-first, CodeIgniter 4)",
    "type": "project",
    "require": {
        "php": "^8.3",
        "codeigniter4/framework": "^4.5",
        "firebase/php-jwt": "^6.10"
    },
    "require-dev": {
        "codeigniter4/devkit": "^1.1",
        "phpunit/phpunit": "^10.5"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        }
    },
    "scripts": {
        "post-update-cmd": [
            "CodeIgniter\\Config\\AutoloadConfig::discover"
        ]
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
